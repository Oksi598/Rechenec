{
  "openapi": "3.0.1",
  "info": {
    "title": "Logistics.Api",
    "version": "1.0"
  },
  "paths": {
    "/api/tms/routes/{routeId}/optimize-load": {
      "post": {
        "tags": [
          "TmsCommands"
        ],
        "parameters": [
          {
            "name": "routeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/tms/delivery-proofs/sync": {
      "post": {
        "tags": [
          "TmsCommands"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "orderId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "clientProofId": {
                    "type": "string"
                  },
                  "signature": {
                    "type": "string"
                  },
                  "photo": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              },
              "encoding": {
                "orderId": {
                  "style": "form"
                },
                "clientProofId": {
                  "style": "form"
                },
                "signature": {
                  "style": "form"
                },
                "photo": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/tms/drivers/{driverId}/public": {
      "get": {
        "tags": [
          "TmsQueries"
        ],
        "parameters": [
          {
            "name": "driverId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "scope",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/DriverPublicDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DriverPublicDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/DriverPublicDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/tms/contacts/{externalContactId}/public": {
      "get": {
        "tags": [
          "TmsQueries"
        ],
        "parameters": [
          {
            "name": "externalContactId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "scope",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalContactDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalContactDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalContactDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DriverPublicDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fullName": {
            "type": "string",
            "nullable": true
          },
          "contact": {
            "$ref": "#/components/schemas/MaskedContactDto"
          }
        },
        "additionalProperties": false
      },
      "ExternalContactDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fullName": {
            "type": "string",
            "nullable": true
          },
          "contact": {
            "$ref": "#/components/schemas/MaskedContactDto"
          }
        },
        "additionalProperties": false
      },
      "MaskedContactDto": {
        "type": "object",
        "properties": {
          "maskedEmail": {
            "type": "string",
            "nullable": true
          },
          "maskedPhone": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}